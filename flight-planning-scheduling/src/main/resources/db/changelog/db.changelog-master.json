{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "app-users-schema-init",
        "author": "airline-team",
        "preConditions": [
          {
            "onFail": "MARK_RAN",
            "onError": "MARK_RAN",
            "not": {
              "tableExists": {
                "tableName": "app_users"
              }
            }
          }
        ],
        "changes": [
          {
            "createTable": {
              "tableName": "app_users",
              "columns": [
                {
                  "column": {
                    "name": "id",
                    "type": "VARCHAR(36)",
                    "constraints": {
                      "nullable": false,
                      "primaryKey": true
                    }
                  }
                },
                {
                  "column": {
                    "name": "email",
                    "type": "VARCHAR(255)",
                    "constraints": {
                      "nullable": false,
                      "unique": true
                    }
                  }
                },
                {
                  "column": {
                    "name": "password",
                    "type": "VARCHAR(255)",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "full_name",
                    "type": "VARCHAR(255)"
                  }
                },
                {
                  "column": {
                    "name": "phone_number",
                    "type": "VARCHAR(64)"
                  }
                },
                {
                  "column": {
                    "name": "role",
                    "type": "VARCHAR(64)",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "enabled",
                    "type": "BOOLEAN",
                    "defaultValueBoolean": true,
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "created_at",
                    "type": "TIMESTAMP WITH TIME ZONE"
                  }
                }
              ]
            }
          },
          {
            "createIndex": {
              "indexName": "idx_users_email",
              "tableName": "app_users",
              "columns": [
                {
                  "column": {
                    "name": "email"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}